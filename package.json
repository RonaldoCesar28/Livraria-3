    "node": "20.20.0"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watchAll",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watchAll --coverage",
    "test:auth:service": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/test/services/authService.test.js --detectOpenHandles",
    "test:auth:router": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/test/routes/authRoutes.test.js --detectOpenHandles",
    "test:db": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/test/db/dbconfig.test.js --detectOpenHandles"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "30.4.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jest": "30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
